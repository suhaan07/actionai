# Copy to .env and fill in. Never commit .env.

# Qloo (hackathon key, sent as the X-Api-Key header)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Gemini (Google AI Studio)
GEMINI_API_KEY=

# Supabase (Project Settings → API). URL is the Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Groq (free open-model backup for text calls): console.groq.com/keys
GROQ_API_KEY=

# Pollinations (image mock-ups; secret key sk_... from enter.pollinations.ai/keys)
POLLINATIONS_API_KEY=
